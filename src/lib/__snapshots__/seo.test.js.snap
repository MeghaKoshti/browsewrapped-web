exports[`head tags > for / 1`] = `
"<title>BrowseWrapped — Your Year in Tabs</title>
    <meta name="description" content="Turn your browser history into a Spotify Wrapped-style report: your persona, top topics, browsing rhythm and more. Free, no sign-up." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BrowseWrapped" />
    <meta property="og:title" content="BrowseWrapped — Your Year in Tabs" />
    <meta property="og:description" content="Turn your browser history into a Spotify Wrapped-style report: your persona, top topics, browsing rhythm and more. Free, no sign-up." />
    <meta property="og:image" content="https://browsewrapped.app/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="BrowseWrapped: your year in tabs" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="BrowseWrapped — Your Year in Tabs" />
    <meta name="twitter:description" content="Turn your browser history into a Spotify Wrapped-style report: your persona, top topics, browsing rhythm and more. Free, no sign-up." />
    <meta name="twitter:image" content="https://browsewrapped.app/og-image.png" />
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"SoftwareApplication","name":"BrowseWrapped","url":"https://browsewrapped.app/","applicationCategory":"LifestyleApplication","operatingSystem":"Web browser","description":"Turn your browser history into a Spotify Wrapped-style report: your persona, top topics, browsing rhythm and more. Free, no sign-up.","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"}}</script>
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What do you keep from my history file?","acceptedAnswer":{"@type":"Answer","text":"The file itself is deleted as soon as it has been analysed. The finished report (totals, topics, top sites, top pages and top searches) is kept for 7 days so you can reopen it, then deleted. You can delete it sooner with “Delete this report now”."}},{"@type":"Question","name":"Do you sell or share my browsing data?","acceptedAnswer":{"@type":"Answer","text":"No. We don’t sell data, show ads or build profiles. Share links you create contain totals and topics only, never addresses, page titles, searches or site names, and expire after 30 days."}},{"@type":"Question","name":"Is my history sent to an AI?","acceptedAnswer":{"@type":"Answer","text":"Only up to 50 site names our rules don’t recognise (like example.com) may be sent to Google Gemini to pick a topic. Never full addresses, page titles, searches or your IP address."}},{"@type":"Question","name":"Do I need an account?","acceptedAnswer":{"@type":"Answer","text":"No. The full report is free with no sign-up. If you buy the optional Wrapped Pass, it is linked to your email only."}},{"@type":"Question","name":"Can I try it without uploading anything?","acceptedAnswer":{"@type":"Answer","text":"Yes. “Try with sample data” shows a full report made from a made-up history."}},{"@type":"Question","name":"Which browsers work?","acceptedAnswer":{"@type":"Answer","text":"Chrome, Edge, Firefox and Safari, plus Brave, Vivaldi and Opera (they keep a Chrome-style History file), or any CSV or JSON export."}}]}</script>"
`;

