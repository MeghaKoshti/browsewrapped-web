# Copy to .env.local (not committed) or set in Vercel → Project → Settings → Environment Variables.
# The Rails API's URL. Leave empty in development: Vite proxies /api to localhost:3000.
# Both https://browsewrapped-api.onrender.com and .../api work. Production uses the Render URL.
VITE_API_URL=

# Legal pages (/privacy, /terms, /refund, /contact). Read at build time.
# Until these are set the pages show "[Operator name]", "contact@example.com" and "[City]".
VITE_LEGAL_NAME=
VITE_CONTACT_EMAIL=
VITE_LEGAL_CITY=
